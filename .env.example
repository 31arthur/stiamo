# Supabase project (Dashboard → Project Settings → API). Copy to .env.local and fill in.
# Leave empty to run fully offline on browser storage with the demo account.
# The publishable key is meant for browsers; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show the "Create account" form on the login page. Off by default.
# VITE_ALLOW_SIGNUP=true
